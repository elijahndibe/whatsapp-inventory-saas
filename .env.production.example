# Copy to .env on the production host, fill in every blank, then run
# `php artisan key:generate --force` if APP_KEY is still blank.
# See DEPLOYMENT.md for the full checklist this file is part of.

APP_NAME="Zwenko"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Database-backed sessions/cache/queue work fine at small-to-mid scale;
# switch to redis (already provisioned in docker-compose.yml) once queue
# throughput or session read load becomes a bottleneck.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
# Switch to s3 once running more than one app instance, or once business
# logo storage needs to survive container/instance replacement:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Live Paystack keys — never the test sk_test_/pk_test_ pair from .env.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

WHATSAPP_API_VERSION=v20.0
# All of these are the platform's own Meta app — see WHATSAPP_SETUP.md.
# WHATSAPP_APP_SECRET is required — the webhook handler fails closed
# (rejects everything) if it's left blank.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
# Platform's own WhatsApp number, for phone-verification codes only — see
# .env.example for details. Left blank, phone verification is not enforced.
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=phone_verification

APP_SUPPORT_PHONE=
